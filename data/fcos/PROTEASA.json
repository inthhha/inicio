{
  "farmacologia": "Acción y mecanismo:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Antiinflamatoria-antiedematosa.</BODY></HTML></p>",
  "indicaciones": "Indicaciones:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Procesos de tipo inflamatorio y edematoso salvo los de origen renal o card&iacute;aco.</BODY></HTML></p><p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Neuritis, herpes (z&oacute;ster, oft&aacute;lmico, simple), tabes dorsal y varicela.</BODY></HTML></p>",
  "posologia": "Posología:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY><b>Adultos</b>: 1-2 grageas 4 veces al d&iacute;a. Oral.<br>Forte: 2 grageas 3 veces al d&iacute;a. Oral.</BODY></HTML></p><p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY><b>Adultos</b> y ni&ntilde;os mayores de 4 a&ntilde;os: 1 ampolla diaria en una &uacute;nica dosis, durante 5 o m&aacute;s d&iacute;as. I.M.<br>Ni&ntilde;os de 1-4 a&ntilde;os: la mitad de la dosis del adulto. I.M.</BODY></HTML></p>",
  "posologia_y_forma_de_administracion": "",
  "normas_para_la_correcta_administracion": "",
  "posologia_en_insuficiencia_hepatica": "",
  "posologia_en_insuficiencia_renal": "",
  "interacciones": {
    "texto_epigrafe": "Interacciones:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>No emplear simult&aacute;neamente con anticoagulantes.</BODY></HTML></p>",
    "detalle": []
  },
  "reacciones_adversas": "Reacciones adversas:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Trastornos gastrointestinales y al&eacute;rgicos y hematuria, ocasionalmente.</BODY></HTML></p><p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Reacciones anafil&aacute;cticas por inyecci&oacute;n I.V. accidental.</BODY></HTML></p>",
  "contraindicaciones": "Contraindicaciones:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Hipersensibilidad al medicamento.<br>Infecciones sist&eacute;micas, septicemias, trastornos de la coagulaci&oacute;n sangu&iacute;nea.</BODY></HTML></p>",
  "precauciones": "Precauciones:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Embarazo.</BODY></HTML></p><p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY>Hipersensibilidad al medicamento.</BODY></HTML></p>",
  "advertencias_precaucion_extrema_aemps": "",
  "embarazo_y_lactancia": "Embarazo:\n<p style='text-indent:0px;'><!DOCTYPE HTML PUBLIC \"-//W3C//DTD HTML 4.0 Transitional//EN\"><HTML><HEAD><META content=\"text/html; charset=unicode\" http-equiv=Content-Type><META name=BotPlus2 content=1><META name=GENERATOR content=\"MSHTML 11.00.9600.19375\"></HEAD><BODY> <br><EM>Seguridad en animales</EM>: los estudios realizados en animales no muestran indicios de absorci&oacute;n de las enzimas pancre&aacute;ticas porcinas. Por tanto, no se prev&eacute; ninguna toxicidad para la reproducci&oacute;n ni el desarrollo. <br><br><EM>Seguridad en humanos</EM>: no se disponen estudios adecuados y bien controlados en humanos. Deben tomarse precauciones a la hora de prescribir esta medicaci&oacute;n a las embarazadas. <br><EM>Efectos sobre la fertilidad</EM>: no hay estudios espec&iacute;ficos en humanos.<br></BODY></HTML></p>",
